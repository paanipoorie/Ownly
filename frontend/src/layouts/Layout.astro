---
import "../styles/globals.css";
export interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title} | Ownly - Personal Ownership Hub</title>
    <meta name="description" content="Centralize your owned items, track warranties, return deadlines, and receipt invoices in one searchable hub." />
  </head>
  <body class="min-h-screen bg-background text-foreground font-sans antialiased selection:bg-indigo-500 selection:text-white">
    <slot />
  </body>
</html>
<style is:global>
  body {
    font-family: 'Plus Jakarta Sans', sans-serif;
  }
</style>